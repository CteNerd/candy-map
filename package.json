{
  "name": "candy-map",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "infrastructure",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/shared && npm run build --workspace services/api && npm run build --workspace apps/web && npm run build --workspace infrastructure",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:web": "npm run dev --workspace apps/web",
    "cdk": "npm run cdk --workspace infrastructure",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
