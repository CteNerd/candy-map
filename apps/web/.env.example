# Copy to .env.local (gitignored) and fill in after `cdk deploy` outputs the stack values.

# From the CDK stack's "ApiUrl" output.
VITE_API_BASE_URL=

# From the CDK stack's "CognitoHostedUiDomain" output, e.g. https://candy-map-poc.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# From the CDK stack's "UserPoolClientId" output.
VITE_COGNITO_CLIENT_ID=
